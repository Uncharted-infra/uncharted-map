# Uncharted — single Supabase project (ref: epgtqkixcynukyqoeioo)
# Auth + profiles + product data. Vercel env lives on uncharted-map only.

NEXT_PUBLIC_SUPABASE_URL=https://epgtqkixcynukyqoeioo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Or legacy anon JWT:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

NEXT_PUBLIC_SITE_ORIGIN=https://uncharted.sh
NEXT_PUBLIC_MAP_ORIGIN=https://map.uncharted.sh
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.uncharted.sh

# Local development (required for localhost — do not use .uncharted.sh cookie domain locally)
# NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_MAP_ORIGIN=http://localhost:3001
# NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# Inventory data layer (GraphQL + Redis + flights sidecar)
# REDIS_URL=redis://localhost:6379
# FLIGHTS_SIDECAR_URL=http://localhost:8080

# Set to 1 to run full Supabase auth gate on localhost (default skips middleware auth in dev)
# MAP_DEV_AUTH=1
