# Uncharted map app — owns Supabase auth + owner data (ref: epgtqkixcynukyqoeioo)
# Vercel env lives on uncharted-map only. Site carries no secrets.

NEXT_PUBLIC_SUPABASE_URL=https://epgtqkixcynukyqoeioo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

NEXT_PUBLIC_SITE_ORIGIN=https://uncharted.sh
NEXT_PUBLIC_MAP_ORIGIN=https://map.uncharted.sh

# Shared auth cookie across subdomains. Leave empty on localhost.
AUTH_COOKIE_DOMAIN=.uncharted.sh

# Local development
# NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_MAP_ORIGIN=http://localhost:3001
# AUTH_COOKIE_DOMAIN=
